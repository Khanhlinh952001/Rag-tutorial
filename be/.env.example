# Postgres trong Docker (docker-compose service `db`)
# Chạy app/Prisma trên máy host → host: localhost
PORT="3080"
DATABASE_URL=""
VECTOR_STORE="pgvector"
PGVECTOR_TABLE="document_vectors"
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="document_chunks"
PPTX_OCR="false"
# kor+eng+jpn+chi_sim+vie — ảnh đa ngôn ngữ (HN/EN/JP/中文). Thêm chi_tra nếu cần chữ Hán phồn thể.
OCR_LANGS="kor+eng+jpn+chi_sim+vie"
OCR_PSM="6"
OCR_MIN_CHARS_FALLBACK="40"
# merge = nhiều chế độ PSM rồi lấy bản dài nhất (chậm hơn, chính xác hơn). fast = ít lần recognize hơn.
OCR_STRATEGY="merge"
# Ảnh OCR chậm vì: (1) Tesseract nhiều ngôn ngữ + nhiều PSM, (2) pipeline có thể gọi Vision + fuse LLM (timeout dài).
# Code đã tái dùng kết quả PSM-3 từ probe để bớt một lần recognize. Muốn nhanh hơn: OCR_STRATEGY=fast, ít OCR_LANGS,
# IMAGE_VISION_ENABLED=false, IMAGE_PIPELINE_LLM_FUSE=false, hoặc IMAGE_RAG_PIPELINE=false.
UPLOAD_MAX_FILES="30"
# Ảnh: probe OCR — nếu ít chữ → Vision (caption+tags) rồi embed; nhiều chữ → OCR đầy đủ.
IMAGE_OCR_MIN_CHARS="80"
IMAGE_VISION_ENABLED="true"
OPENAI_VISION_MODEL="gpt-4o-mini"
IMAGE_VISION_TIMEOUT_MS="90000"
# Ảnh RAG pipeline (mặc định bật): phân loại → importance → OCR/Vision/Layout → fuse → chunk/embed.
# Đặt false để quay lại luồng cũ (chỉ probe độ dài → OCR hoặc Vision).
IMAGE_RAG_PIPELINE="true"
# Fusion LLM (cần OPENAI_API_KEY). false = chỉ ghép template markdown.
IMAGE_PIPELINE_LLM_FUSE="true"
# Model chat text-only cho bước fuse (mặc định: OPENAI_MODEL → OPENAI_VISION_MODEL → gpt-4o-mini).
# OPENAI_IMAGE_FUSE_MODEL=""
# IMAGE_PIPELINE_MIN_VISION_WEIGHT="0.11"
# IMAGE_PIPELINE_FUSE_TIMEOUT_MS="45000"
# OCR_PROBE_LANGS=""  # để trống = dùng cùng OCR_LANGS (chậm hơn); có thể đặt eng+kor để probe nhanh
TIKA_URL="http://localhost:9998/tika"
CHUNKING_STRATEGY="recursive"
SEMANTIC_BREAK_THRESHOLD="0.72"
CHUNK_SIZE="1000"
CHUNK_OVERLAP="200"
# Very short trailing chunks are merged into the previous chunk (0 = off).
CHUNK_MERGE_MIN_LEN="140"
# Optional cross-encoder rerank after vector search (needs COHERE_API_KEY).
# RERANKER_PROVIDER="" | "cohere"
# COHERE_API_KEY=""
# COHERE_RERANK_MODEL="rerank-multilingual-v3.0"
# RERANK_COHERE_CANDIDATE_K="24"
# RERANK_COHERE_MAX_DOC_CHARS="16000"
# Map Cohere scores into cosine-like range for RETRIEVAL_SCORE_THRESHOLD (true|false).
# RERANK_COHERE_MAP_TO_VECTOR_RANGE="true"
# RERANK_COHERE_SCORE_MAP_LO="0.52"
# RERANK_COHERE_SCORE_MAP_HI="0.94"
REDIS_HOST="localhost"
REDIS_PORT="6379"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_CHAT_TOP_K="10"
RETRIEVAL_SCORE_THRESHOLD="0.7"
HYBRID_KEYWORD_WEIGHT="0.2"
# Max context blocks in the grounded RAG prompt (default 8, max 12).
# RAG_PROMPT_MAX_CONTEXTS="8"

JWT_SECRET="your-strong-secret"
JWT_EXPIRES_IN="7d"

# AI chat rate limits (per JWT user, 429) + parallel LLM cap
AI_CHAT_THROTTLE_BURST_LIMIT="10"
AI_CHAT_THROTTLE_BURST_MS="10000"
AI_CHAT_THROTTLE_LIMIT="45"
AI_CHAT_THROTTLE_TTL_MS="60000"
LLM_MAX_CONCURRENT="16"