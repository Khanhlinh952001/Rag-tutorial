# Sao chép thành `.env` và chỉnh giá trị (file `.env` không commit lên Git).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
# Production (sau khi nginx + DNS rag.api.linhdev.cloud → BE:3002, rồi `pnpm build` lại FE):
# NEXT_PUBLIC_API_BASE_URL=https://rag.api.linhdev.cloud

# Admin login — mặc định form (dev)
NEXT_PUBLIC_ADMIN_EMAIL=admin@local.dev
NEXT_PUBLIC_ADMIN_PASSWORD=admin123456

# User chat login — mặc định form (dev)
NEXT_PUBLIC_USER_EMAIL=user@local.dev
NEXT_PUBLIC_USER_PASSWORD=user123456

# `false` để ẩn panel web scan trong admin documents (mặc định: hiển thị)
# NEXT_PUBLIC_WEB_DEV_PANEL=
